\title{\LARGE \bf
Locomotion-Grounded Humanoid Soccer: Task-Gated Reinforcement\\
Learning of a Multi-Directional Kicking Library
}

\author{Anonymous Authors% <-this % stops a space
}

\begin{document}

\maketitle
\thispagestyle{empty}
